# Render supplies the HTTP port at runtime.
PORT=5000
# Fake MongoDB URI for local configuration examples.
MONGO_URI=mongodb://mongo.example.invalid:27017
# Fake Redis TCP URI; use rediss:// when the provider requires TLS.
REDIS_URL=rediss://default:replace-with-fake-password@redis.example.invalid:6379/0
# Fake signing secret; replace it with a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-placeholder-secret-at-least-32-characters
# Exact frontend origin allowed by CORS and WebSocket origin checks.
CLIENT_URL=https://app.example.invalid
# Enable Secure and SameSite=None cookies on the HTTPS production host.
COOKIE_SECURE=false
# Trust Render's X-Forwarded-For header for client IPs only in a proxy deployment.
TRUST_PROXY_HEADERS=false
# Interval between WebSocket ping frames.
WS_PING_INTERVAL=30s
# Maximum time to wait for a WebSocket pong.
WS_PONG_WAIT=60s
# Deadline for each WebSocket write.
WS_WRITE_WAIT=10s
# Maximum size of a WebSocket message in bytes.
WS_MAX_MESSAGE_BYTES=1024
# Maximum concurrent WebSocket connections allowed per IP.
WS_MAX_CONNECTIONS_PER_IP=20
